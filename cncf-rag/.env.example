# ── Embedding (required) ──────────────────────────────────────────────────────
# OpenAI text-embedding-3-small is used for all document and query embeddings.
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ── Generation (required) ─────────────────────────────────────────────────────
# Controls which LLM answers the user's question.
# "openai" → GPT-4o-mini (cheap, fast, good instruction-following)
# "anthropic" → claude-sonnet-4-5 (higher faithfulness, but Anthropic key required)
GENERATION_PROVIDER=openai
OPENAI_GENERATION_MODEL=gpt-4o-mini

# Required only when GENERATION_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ── Reranking (required) ──────────────────────────────────────────────────────
# Cohere rerank-english-v3.0 is used for EXPLORATORY and CROSS_PROJECT queries.
# Free trial key from dashboard.cohere.com is sufficient (per-query usage only).
COHERE_API_KEY=REPLACE_ME

# ── LLM Document Classification (optional) ───────────────────────────────────
# When true, all docs fall back to rule-based classification only (no Anthropic calls).
# Saves ~$0.03 per full corpus ingest. Quality difference is small.
# Set to false (and supply ANTHROPIC_API_KEY) when you want better chunking for
# Helm/ArgoCD/Prometheus docs that have no structured frontmatter.
DISABLE_LLM_CLASSIFICATION=true

# ── Vector store ──────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=cncf_docs

# ── AWS (for EC2 deployment only — not needed for local dev) ──────────────────
AWS_REGION=us-east-1
S3_CORPUS_BUCKET=cncf-rag-corpus-REPLACE_ME

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
API_PORT=8000
# Optional: OpenTelemetry traces (comment out if not running a collector)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=cncf-rag
